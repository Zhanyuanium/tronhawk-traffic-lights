{
  "id": "com.tronhawk.traffic-lights",
  "name": "Traffic Lights",
  "version": "0.1.0",
  "author": "TronHawk Contributors",
  "tronhawk": "^0.1",
  "entry": {
    "css": "style.css",
    "renderer": "src/renderer.js"
  },
  "permissions": ["renderer.css", "renderer.dom", "renderer.script", "electron.windowControls"],
  "config": {
    "overlay-left-offset": {
      "type": "number",
      "default": 0,
      "label": "Overlay left adjustment L, DIP (0-256)"
    },
    "overlay-region-height": {
      "type": "number",
      "default": 30,
      "label": "Overlay region height H, DIP (30-64)"
    },
    "tooltip-close": {
      "type": "string",
      "default": "",
      "label": "Close tooltip override (empty = language default)"
    },
    "tooltip-minimize": {
      "type": "string",
      "default": "",
      "label": "Minimize tooltip override (empty = language default)"
    },
    "tooltip-maximize": {
      "type": "string",
      "default": "",
      "label": "Maximize tooltip override (empty = language default)"
    },
    "tooltip-restore": {
      "type": "string",
      "default": "",
      "label": "Restore tooltip override (empty = language default)"
    },
    "decorative-fallback-lights": {
      "type": "boolean",
      "default": true,
      "label": "Decorative fallback lights (decorative, not clickable)"
    },
    "host-overlay-fallback": {
      "type": "boolean",
      "default": true,
      "label": "Host overlay fallback (functional host overlay, clickable)"
    }
  }
}
